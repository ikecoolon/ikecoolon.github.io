{
  "name": "camp-in-home",
  "version": "1.0.0",
  "author": "ikecoolon@hotmail.com",
  "description": "营会中心前端",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.ts,.jsx,.tsx --fix",
    "lint:style": "stylelint **/*.{vue,css,scss,postcss,less} --fix",
    "format": "prettier --write .",
    "deploy": "sh deploy.sh",
    "deploy-dist": "sh deploy-simple.sh",
    "generate-password": "node scripts/generate-password.js",
    "update-password": "node scripts/update-password.cjs update",
    "view-password": "node scripts/update-password.cjs view",
    "init-password": "node scripts/update-password.cjs init",
    "setup-email": "node scripts/setup-email.cjs",
    "test-email": "node scripts/test-email.cjs",
    "mail-proxy": "node scripts/mail-proxy.cjs",
    "test-mail-proxy": "node scripts/test-mail-proxy.cjs",
    "mail-service": "cd server && npm start",
    "test-mail-service": "cd server && npm test"
  },
  "devDependencies": {
    "@iconify-json/carbon": "^1.2.13",
    "@iconify-json/mdi": "^1.2.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.11.17",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@unocss/eslint-plugin": "^0.58.5",
    "@vitejs/plugin-vue": "^5.0.4",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.20.1",
    "prettier": "^3.2.5",
    "stylelint": "^16.2.1",
    "stylelint-config-standard": "^36.0.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "typescript": "^5.3.3",
    "unocss": "^0.58.5",
    "vite": "^5.1.4",
    "vue-tsc": "^1.8.27"
  },
  "dependencies": {
    "@unocss/reset": "^0.58.5",
    "ant-design-vue": "^4.1.2",
    "cors": "^2.8.5",
    "dayjs": "^1.11.10",
    "express": "^5.1.0",
    "lodash-es": "^4.17.21",
    "nodemailer": "^7.0.6",
    "pinia": "^2.1.7",
    "vue": "^3.4.19",
    "vue-router": "^4.2.5"
  }
}
